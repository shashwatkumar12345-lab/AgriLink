rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: users can read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      // Allow experts/consultants to be read by any authenticated user for the directory
      allow read: if isAuthenticated() && (resource.data.role == 'consultant' || resource.data.role == 'trainee');
    }

    // Harvests collection: users can read and write their own harvest records
    match /harvests/{harvestId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Animals collection: users can read and write their own animal records
    match /animals/{animalId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Consultations collection: farmers and consultants can read/write their requests
    match /consultations/{consultationId} {
      allow read, write: if isAuthenticated() && 
        (request.resource.data.farmerId == request.auth.uid || 
         request.resource.data.consultantId == request.auth.uid);
      allow read, delete, update: if isAuthenticated() && 
        (resource.data.farmerId == request.auth.uid || 
         resource.data.consultantId == request.auth.uid);
    }

    // Business Plans collection: users can read and write their own business plans
    match /business_plans/{planId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Market Price Index (Public Read, Admin Write - for now allowing any authenticated user to read)
    match /market_price_index/{docId} {
      allow read: if true;
      allow write: if isAuthenticated(); // In a real app, restrict this to admins
    }

    // Translations Cache (Public Read, Authenticated Write)
    match /translations_cache/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Image Caches (Public Read, Authenticated Write)
    match /module_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /step_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /crop_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /animal_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Shared Notifications (Public Read, Authenticated Write)
    match /shared_area_updates/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Catch-all for any other collections (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
