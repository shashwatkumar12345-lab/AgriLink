{
  "name": "agrilink-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "cap:init": "cap init",
    "cap:android": "npm run build && cap add android && cap sync",
    "cap:ios": "npm run build && cap add ios && cap sync",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/preferences": "^6.0.2",
    "@google/genai": "latest",
    "express": "^5.2.1",
    "firebase": "^10.8.0",
    "http-proxy-middleware": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
